# Copy to .env and adjust as needed. Never commit .env.

# Postgres connection (local dev defaults, installed user-scoped)
DATABASE_URL=postgresql://deadwax:deadwax@127.0.0.1:5432/deadwax_dev

# API
PORT=3001
NODE_ENV=development

# 32+ char random string used to sign session cookies
SESSION_SECRET=dev-only-change-me-please-32-chars-min

# Where the Vite dev server runs (used for CORS + cookie settings)
CLIENT_ORIGIN=http://localhost:5173

# Payment provider
# simulated needs no keys. stripe needs a sandbox secret key and the signing
# secret printed by `stripe listen --forward-to localhost:3001/api/webhooks/stripe`.
PAYMENTS_MODE=simulated
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
STRIPE_SECRET_KEY=

# The publishable key belongs in client/.env as VITE_STRIPE_PUBLISHABLE_KEY,
# because the browser needs it to mount Stripe Elements.

